{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/agrochain",
      "destination": "/projects/agrochain",
      "permanent": true
    },
    {
      "source": "/meri-panchayat",
      "destination": "/projects/meri-panchayat",
      "permanent": true
    },
    {
      "source": "/helio",
      "destination": "/projects/helio",
      "permanent": true
    },
    {
      "source": "/printflow",
      "destination": "/projects/printflow",
      "permanent": true
    },
    {
      "source": "/smart-recipe-generator",
      "destination": "/projects/smart-recipe-generator",
      "permanent": true
    },
    {
      "source": "/resume-builder",
      "destination": "/projects/resume-builder",
      "permanent": true
    },
    {
      "source": "/wedding-invitation",
      "destination": "/projects/wedding-invitation",
      "permanent": true
    },
    {
      "source": "/news-scraper",
      "destination": "/projects/news-scraper",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}

